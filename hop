#!/usr/bin/env bash
set -euo pipefail

CONFIG=${HOP_CONFIG:-$HOME/.config/hop/env}
if [[ -f $CONFIG ]]; then
  source "$CONFIG"
fi

TS_API=${HOP_TS_API:-https://api.tailscale.com/api/v2}
TS_TAG=${HOP_TS_TAG:-tag:hop}
TTL_HOURS=${HOP_TTL_HOURS:-8}
JOIN_TIMEOUT=${HOP_JOIN_TIMEOUT:-240}
ZONE_TIMEOUT=${HOP_ZONE_TIMEOUT:-600}
MIN_MEMORY_MIB=${HOP_MIN_MEMORY_MIB:-512}
POLL_INTERVAL=${HOP_POLL_INTERVAL:-5}
HOME_REGION=${HOP_HOME_REGION:-us-east-1}
SG_NAME=hop
WG_PORT=41641
TS_TOKEN=
ZONE_TYPE=

export AWS_PAGER=
export AWS_DEFAULT_OUTPUT=json

die() {
  echo "hop: $*" >&2
  exit 1
}

log() {
  echo "$*" >&2
}

usage() {
  cat <<EOF
Usage: hop <command>

  up <place> [--ttl HOURS] [--spot]
                              launch the cheapest exit node a region or zone offers and route this Mac
                              through it; --spot uses spare capacity, which AWS can reclaim at any time
  down [place]                stop using and destroy the nodes in that region, or every node
  status [--json]             list running nodes and which one is in use
  regions                     list the regions this AWS account can launch in
  zones                       list the Local and Wavelength Zones under those regions
  doctor                      check tools, credentials and Tailscale access

Settings are read from $CONFIG:
  HOP_AWS_PROFILE      AWS CLI profile to launch into (required)
  HOP_TTL_HOURS        hours before a node destroys itself (default 8)
  HOP_TS_TAG           Tailscale tag for nodes (default tag:hop)
  HOP_MIN_MEMORY_MIB   least instance memory to accept (default 512)
EOF
}

aws_() {
  [[ -n ${HOP_AWS_PROFILE:-} ]] || die "HOP_AWS_PROFILE is not set; add it to $CONFIG"
  aws --profile "$HOP_AWS_PROFILE" "$@"
}

ts_cred() {
  local value=${!1:-}
  if [[ -z $value ]]; then
    value=$(security find-generic-password -s hop -a "$2" -w 2>/dev/null) ||
      die "no Tailscale OAuth credential: set $1 or add Keychain item (service hop, account $2)"
  fi
  printf %s "$value"
}

ts_fetch_token() {
  local id secret token
  id=$(ts_cred TS_OAUTH_CLIENT_ID ts-oauth-client-id) || exit 1
  secret=$(ts_cred TS_OAUTH_CLIENT_SECRET ts-oauth-client-secret) || exit 1
  token=$(printf 'client_id=%s&client_secret=%s' "$id" "$secret" |
    curl -fsS -d @- "$TS_API/oauth/token" | jq -r '.access_token // empty') ||
    die "Tailscale rejected the OAuth client"
  [[ -n $token ]] || die "Tailscale returned no access token"
  printf %s "$token"
}

ts_login() {
  [[ -n $TS_TOKEN ]] || TS_TOKEN=$(ts_fetch_token)
}

ts_api() {
  local method=$1 path=$2 body=${3:-}
  ts_login
  if [[ -n $body ]]; then
    printf 'Authorization: Bearer %s\n' "$TS_TOKEN" |
      curl -fsS -X "$method" -H @- -H 'Content-Type: application/json' -d "$body" "$TS_API$path"
  else
    printf 'Authorization: Bearer %s\n' "$TS_TOKEN" |
      curl -fsS -X "$method" -H @- "$TS_API$path"
  fi
}

ts_mint_key() {
  local body
  body=$(jq -n --arg tag "$TS_TAG" '{
    capabilities: {devices: {create: {reusable: false, ephemeral: true, preauthorized: true, tags: [$tag]}}},
    expirySeconds: 600,
    description: "hop"
  }')
  ts_api POST /tailnet/-/keys "$body"
}

ts_delete_devices() {
  local id
  [[ -n $TS_TOKEN ]] || return 0
  for id in $(ts_api GET "/tailnet/-/devices?tags=$TS_TAG" | jq -r --arg tag "$TS_TAG" --arg host "${1:-}" \
    '.devices[]? | select((.tags // []) | index($tag)) | select($host == "" or .hostname == $host) | .id'); do
    if ts_api DELETE "/device/$id" >/dev/null; then
      log "removed tailnet device $id"
    fi
  done
}

ts_peer() {
  tailscale status --json 2>/dev/null | jq -c --arg h "$1" '[.Peer[]? | select(.HostName == $h)][0] // empty' || true
}

ts_current_exit() {
  tailscale status --json 2>/dev/null | jq -r '[.Peer[]? | select(.ExitNode)][0].HostName // empty' || true
}

ts_release() {
  local current
  current=$(ts_current_exit)
  if [[ -n $current && $current == $1 ]]; then
    tailscale set --exit-node=
    log "stopped routing through $current"
  fi
}

is_zone() {
  [[ $1 =~ ^([a-z]+(-[a-z]+)+-[0-9]+)-. ]]
}

region_of() {
  if is_zone "$1"; then
    echo "${BASH_REMATCH[1]}"
  else
    echo "$1"
  fi
}

enabled_regions() {
  aws_ ec2 describe-regions --region "$HOME_REGION" --query 'Regions[].RegionName' --output text | tr '\t' '\n' | sort
}

scan_region() {
  local region=$1 instances sg subnets rtbs cagws
  instances=$(aws_ ec2 describe-instances --region "$region" \
    --filters Name=tag-key,Values=hop Name=instance-state-name,Values=pending,running \
    --query 'Reservations[].Instances[].{id:InstanceId,ip:PublicIpAddress||NetworkInterfaces[0].Association.CarrierIp,type:InstanceType,spot:InstanceLifecycle,launched:LaunchTime,zone:Placement.AvailabilityZone,host:Tags[?Key==`hop`]|[0].Value}')
  sg=$(aws_ ec2 describe-security-groups --region "$region" \
    --filters "Name=group-name,Values=$SG_NAME" Name=tag-key,Values=hop \
    --query 'SecurityGroups[0].GroupId' --output text)
  subnets=$(aws_ ec2 describe-subnets --region "$region" --filters Name=tag-key,Values=hop \
    --query 'Subnets[].SubnetId')
  rtbs=$(aws_ ec2 describe-route-tables --region "$region" --filters Name=tag-key,Values=hop \
    --query 'RouteTables[].RouteTableId')
  cagws=$(aws_ ec2 describe-carrier-gateways --region "$region" \
    --filters Name=tag-key,Values=hop Name=state,Values=pending,available \
    --query 'CarrierGateways[].CarrierGatewayId' 2>/dev/null) || cagws='[]'
  jq -n --arg region "$region" --arg sg "$sg" --argjson instances "$instances" \
    --argjson subnets "$subnets" --argjson rtbs "$rtbs" --argjson cagws "$cagws" \
    '{region: $region, sg: (if $sg == "None" then null else $sg end), subnets: $subnets, rtbs: $rtbs, cagws: $cagws,
      instances: $instances}'
}

scan() {
  local dir region failed=0
  dir=$(mktemp -d)
  for region in "$@"; do
    scan_region "$region" >"$dir/$region.json" 2>"$dir/$region.err" &
  done
  wait
  for region in "$@"; do
    if [[ ! -s $dir/$region.json ]]; then
      log "hop: could not scan $region: $(tail -1 "$dir/$region.err")"
      failed=1
    fi
  done
  jq -s . "$dir"/*.json
  rm -rf "$dir"
  return $failed
}

default_vpc() {
  local vpc
  vpc=$(aws_ ec2 describe-vpcs --region "$1" --filters Name=is-default,Values=true \
    --query 'Vpcs[0].[VpcId,CidrBlock]' --output text) || exit 1
  [[ $vpc != None* ]] ||
    die "$1 has no default VPC; create one with: aws --profile $HOP_AWS_PROFILE ec2 create-default-vpc --region $1"
  echo "$vpc"
}

ensure_zone() {
  local region=$1 zone=$2 status group waited=0
  read -r status group ZONE_TYPE <<<"$(aws_ ec2 describe-availability-zones --region "$region" --all-availability-zones \
    --filters "Name=zone-name,Values=$zone" Name=zone-type,Values=local-zone,wavelength-zone \
    --query 'AvailabilityZones[0].[OptInStatus,GroupName,ZoneType]' --output text)"
  [[ -n $status ]] || die "could not look up $zone in $region"
  [[ $status != None ]] || die "$zone is not a Local or Wavelength Zone of $region; see 'hop zones'"
  [[ $status == not-opted-in ]] || return 0
  aws_ ec2 modify-availability-zone-group --region "$region" --group-name "$group" --opt-in-status opted-in >/dev/null ||
    die "could not enable zone group $group"
  log "enabled zone group $group on the account; this takes a few minutes the first time"
  while ((waited < ZONE_TIMEOUT)); do
    status=$(aws_ ec2 describe-availability-zones --region "$region" --all-availability-zones \
      --filters "Name=zone-name,Values=$zone" --query 'AvailabilityZones[0].OptInStatus' --output text | cut -f1)
    [[ $status == opted-in ]] && return 0
    sleep "$POLL_INTERVAL"
    waited=$((waited + POLL_INTERVAL))
  done
  die "$zone is still being enabled; try again in a few minutes"
}

ensure_subnet() {
  local region=$1 zone=$2 vpc=$3 cidr=$4 subnet third
  subnet=$(aws_ ec2 describe-subnets --region "$region" \
    --filters "Name=availability-zone,Values=$zone" "Name=vpc-id,Values=$vpc" \
    --query 'Subnets[0].SubnetId' --output text) || exit 1
  if [[ $subnet == None ]]; then
    for third in 255 254 253 252 251 250 249 248; do
      subnet=$(aws_ ec2 create-subnet --region "$region" --vpc-id "$vpc" --availability-zone "$zone" \
        --cidr-block "$(cut -d. -f1-2 <<<"$cidr").$third.0/24" \
        --tag-specifications "ResourceType=subnet,Tags=[{Key=hop,Value=subnet},{Key=Name,Value=hop-$zone}]" \
        --query Subnet.SubnetId --output text 2>/dev/null) && break
      subnet=None
    done
    [[ $subnet != None ]] || die "could not create a subnet for $zone in $vpc"
    [[ $ZONE_TYPE != wavelength-zone ]] || route_via_carrier "$region" "$vpc" "$subnet"
  fi
  echo "$subnet"
}

route_via_carrier() {
  local region=$1 vpc=$2 subnet=$3 cagw rtb tries=0
  cagw=$(aws_ ec2 describe-carrier-gateways --region "$region" \
    --filters "Name=vpc-id,Values=$vpc" Name=state,Values=pending,available \
    --query 'CarrierGateways[0].CarrierGatewayId' --output text) || exit 1
  if [[ $cagw == None ]]; then
    cagw=$(aws_ ec2 create-carrier-gateway --region "$region" --vpc-id "$vpc" \
      --tag-specifications "ResourceType=carrier-gateway,Tags=[{Key=hop,Value=cagw}]" \
      --query CarrierGateway.CarrierGatewayId --output text) || exit 1
  fi
  rtb=$(aws_ ec2 create-route-table --region "$region" --vpc-id "$vpc" \
    --tag-specifications "ResourceType=route-table,Tags=[{Key=hop,Value=rtb}]" \
    --query RouteTable.RouteTableId --output text) || exit 1
  until aws_ ec2 create-route --region "$region" --route-table-id "$rtb" \
    --destination-cidr-block 0.0.0.0/0 --carrier-gateway-id "$cagw" >/dev/null 2>&1; do
    tries=$((tries + 1))
    ((tries < 12)) || die "could not route $subnet through carrier gateway $cagw"
    sleep "$POLL_INTERVAL"
  done
  aws_ ec2 associate-route-table --region "$region" --route-table-id "$rtb" --subnet-id "$subnet" >/dev/null ||
    die "could not attach route table $rtb to $subnet"
}

ensure_sg() {
  local region=$1 vpc=$2 sg
  sg=$(aws_ ec2 describe-security-groups --region "$region" \
    --filters "Name=group-name,Values=$SG_NAME" "Name=vpc-id,Values=$vpc" \
    --query 'SecurityGroups[0].GroupId' --output text) || exit 1
  if [[ $sg == None ]]; then
    sg=$(aws_ ec2 create-security-group --region "$region" --group-name "$SG_NAME" --vpc-id "$vpc" \
      --description "hop exit node" \
      --tag-specifications "ResourceType=security-group,Tags=[{Key=hop,Value=sg}]" \
      --query GroupId --output text) || exit 1
    aws_ ec2 authorize-security-group-ingress --region "$region" --group-id "$sg" \
      --ip-permissions "IpProtocol=udp,FromPort=$WG_PORT,ToPort=$WG_PORT,IpRanges=[{CidrIp=0.0.0.0/0}],Ipv6Ranges=[{CidrIpv6=::/0}]" \
      >/dev/null || exit 1
  fi
  echo "$sg"
}

price_code() {
  if [[ $1 == *-wlz-* ]]; then
    sed -E 's/-([a-z]+)-wlz-([0-9]+)$/-\1\2/' <<<"$1"
  elif is_zone "$1"; then
    echo "${1%?}"
  else
    echo "$1"
  fi
}

hourly_prices() {
  aws_ pricing get-products --region us-east-1 --service-code AmazonEC2 \
    --filters "Type=TERM_MATCH,Field=regionCode,Value=$(price_code "$1")" \
    Type=TERM_MATCH,Field=operatingSystem,Value=Linux Type=TERM_MATCH,Field=tenancy,Value=Shared \
    Type=TERM_MATCH,Field=preInstalledSw,Value=NA Type=TERM_MATCH,Field=capacitystatus,Value=Used \
    --query PriceList |
    jq '[.[] | fromjson
      | {type: .product.attributes.instanceType, az: null,
         usd: ([.terms.OnDemand[]?.priceDimensions[]?.pricePerUnit.USD][0] // "0" | tonumber)}]'
}

spot_prices() {
  local region=$1 zone=$2 pattern
  pattern="^${region}[a-z]\$"
  [[ -z $zone ]] || pattern="^$zone\$"
  aws_ ec2 describe-spot-price-history --region "$region" --product-descriptions Linux/UNIX \
    --start-time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --query 'SpotPriceHistory[].{type:InstanceType,az:AvailabilityZone,usd:SpotPrice}' |
    jq --arg pattern "$pattern" '[.[] | select(.az | test($pattern)) | .usd |= tonumber]'
}

pick_types() {
  local region=$1 zone=$2 spot=$3 offered specs prices
  if [[ -n $zone ]]; then
    offered=$(aws_ ec2 describe-instance-type-offerings --region "$region" --location-type availability-zone \
      --filters "Name=location,Values=$zone" --query 'InstanceTypeOfferings[].InstanceType') || exit 1
  else
    offered=$(aws_ ec2 describe-instance-type-offerings --region "$region" \
      --query 'InstanceTypeOfferings[].InstanceType') || exit 1
  fi
  specs=$(aws_ ec2 describe-instance-types --region "$region" \
    --filters Name=hypervisor,Values=nitro Name=bare-metal,Values=false \
    Name=processor-info.supported-architecture,Values=arm64,x86_64 \
    --query 'InstanceTypes[].{type:InstanceType,memory:MemoryInfo.SizeInMiB,archs:ProcessorInfo.SupportedArchitectures}') || exit 1
  if ((spot)); then
    prices=$(spot_prices "$region" "$zone") || exit 1
    [[ $prices != '[]' ]] || die "${zone:-$region} has no spot prices; launch without --spot"
  else
    prices=$(hourly_prices "${zone:-$region}" 2>/dev/null) || prices='[]'
    [[ $prices != '[]' ]] || log "hop: no prices for ${zone:-$region}; choosing by memory instead"
  fi
  specs=$(jq -r -n --argjson offered "$offered" --argjson specs "$specs" --argjson prices "$prices" \
    --argjson min "$MIN_MEMORY_MIB" '
    ($specs
      | map(select(.memory >= $min) | select(.type as $t | $offered | index($t))
          | .arch = (if .archs | index("arm64") then "arm64" else "x86_64" end))) as $usable
    | ($usable | map({key: .type, value: .arch}) | from_entries) as $arch
    | (if ($prices | length) == 0
       then $usable | map({type, az: null, usd: null, rank: .memory})
       else $prices | map(select(.usd > 0 and $arch[.type]) | .rank = .usd) end)
    | sort_by([.rank, ($arch[.type] != "arm64"), .type, .az])
    | .[:8][]
    | "\(.type) \($arch[.type]) \(if .usd then .usd * 100000 | round / 100000 else "?" end) \(.az // "-")"')
  [[ -n $specs ]] || die "${zone:-$region} offers no priced instance type with at least $MIN_MEMORY_MIB MiB of memory"
  echo "$specs"
}

user_data() {
  local host=$1 key=$2 ttl=$3
  cat <<EOF
#!/bin/bash
set -eu
trap 'systemctl poweroff' ERR
systemd-run --on-active=${ttl}h systemctl poweroff
dd if=/dev/zero of=/swap bs=1M count=768 status=none
chmod 600 /swap
mkswap /swap >/dev/null
swapon /swap
cat >/etc/sysctl.d/99-tailscale.conf <<SYSCTL
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
SYSCTL
sysctl -p /etc/sysctl.d/99-tailscale.conf
curl -fsSL https://tailscale.com/install.sh | sh
tailscale up --auth-key=$key --hostname=$host --advertise-exit-node
EOF
}

launch() {
  local region=$1 ttl=$2 host=$3 zone=$4 spot=$5 sg spec specs type arch usd az key file id='' vpc cidr subnet
  local placement address market
  [[ -z $zone ]] || ensure_zone "$region" "$zone"
  specs=$(pick_types "$region" "$zone" "$spot") || exit 1
  key=$(ts_mint_key | jq -r '.key // empty') || true
  [[ -n $key ]] || die "Tailscale returned no auth key; check the OAuth client has the auth_keys scope and $TS_TAG"
  spec=$(default_vpc "$region") || exit 1
  read -r vpc cidr <<<"$spec"
  sg=$(ensure_sg "$region" "$vpc") || exit 1
  if [[ -n $zone ]]; then
    subnet=$(ensure_subnet "$region" "$zone" "$vpc" "$cidr") || exit 1
    address=AssociatePublicIpAddress
    [[ $ZONE_TYPE != wavelength-zone ]] || address=AssociateCarrierIpAddress
    placement=(--network-interfaces "DeviceIndex=0,SubnetId=$subnet,Groups=$sg,$address=true"
      --block-device-mappings "DeviceName=/dev/xvda,Ebs={VolumeType=gp2}")
  else
    placement=(--security-group-ids "$sg")
  fi
  file=$(mktemp)
  chmod 600 "$file"
  user_data "$host" "$key" "$ttl" >"$file"
  while read -r type arch usd az; do
    market=(--instance-initiated-shutdown-behavior terminate)
    if ((spot)); then
      market+=(--instance-market-options
        "MarketType=spot,SpotOptions={SpotInstanceType=one-time,InstanceInterruptionBehavior=terminate}")
      [[ -n $zone ]] || market+=(--placement "AvailabilityZone=$az")
    fi
    if id=$(aws_ ec2 run-instances --region "$region" \
      --image-id "resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-$arch" \
      --instance-type "$type" \
      "${placement[@]}" \
      "${market[@]}" \
      --metadata-options HttpTokens=required \
      --user-data "file://$file" \
      --tag-specifications \
      "ResourceType=instance,Tags=[{Key=hop,Value=$host},{Key=Name,Value=$host}]" \
      "ResourceType=volume,Tags=[{Key=hop,Value=$host}]" \
      --query 'Instances[0].InstanceId' --output text); then
      break
    fi
    log "hop: could not launch $type in ${zone:-$region}; trying the next cheapest"
    id=''
  done <<<"$specs"
  rm -f "$file"
  [[ -n $id ]] || die "launch failed in ${zone:-$region}"
  if ((spot)); then type="$type spot"; fi
  log "launched $id ($type, \$$usd/hour) in ${zone:-$region} as $host"
  aws_ ec2 wait instance-running --region "$region" --instance-ids "$id"
  echo "$id"
}

wait_for_join() {
  local region=$1 host=$2 id=$3 waited=0 peer=''
  log "waiting for $host to join the tailnet"
  while ((waited < JOIN_TIMEOUT)); do
    peer=$(ts_peer "$host")
    if [[ -n $peer && $(jq -r .ExitNodeOption <<<"$peer") == true ]]; then
      return 0
    fi
    sleep "$POLL_INTERVAL"
    waited=$((waited + POLL_INTERVAL))
  done
  if [[ -n $peer ]]; then
    log "hop: $host joined but is not approved as an exit node; add \"exitNode\": [\"$TS_TAG\"] to autoApprovers in the tailnet policy file"
  else
    log "hop: $host did not join within ${JOIN_TIMEOUT}s; last console output:"
    aws_ ec2 get-console-output --region "$region" --instance-id "$id" --latest --query Output --output text 2>/dev/null |
      tail -25 >&2 || true
  fi
  return 1
}

verify_egress() {
  local expected=$1 seen='' tries=0
  while ((tries < 6)); do
    seen=$(curl -fsS --max-time 10 https://checkip.amazonaws.com 2>/dev/null || true)
    [[ $seen == "$expected" ]] && return 0
    sleep "$POLL_INTERVAL"
    tries=$((tries + 1))
  done
  log "hop: public IP is ${seen:-unknown}, expected $expected"
  return 1
}

delete_each() {
  local region=$1 entry=$2 key=$3 kind=$4 flag=$5 id
  for id in $(jq -r --arg key "$key" '.[$key][]' <<<"$entry"); do
    if aws_ ec2 "delete-$kind" --region "$region" "--$flag" "$id" >/dev/null; then
      log "deleted $kind $id in $region"
    else
      log "hop: could not delete $kind $id in $region; run 'hop down $region' again"
    fi
  done
}

destroy_region() {
  local region=$1 entry=$2 ids hosts host sg
  ids=$(jq -r '.instances[].id' <<<"$entry")
  hosts=$(jq -r '.instances[].host' <<<"$entry")
  sg=$(jq -r '.sg // empty' <<<"$entry")
  for host in $hosts; do
    ts_release "$host"
  done
  if [[ -n $ids ]]; then
    aws_ ec2 terminate-instances --region "$region" --instance-ids $ids >/dev/null
    log "terminating ${ids//$'\n'/ } in $region"
    for host in $hosts; do
      ts_delete_devices "$host"
    done
    aws_ ec2 wait instance-terminated --region "$region" --instance-ids $ids
  fi
  delete_each "$region" "$entry" subnets subnet subnet-id
  delete_each "$region" "$entry" rtbs route-table route-table-id
  delete_each "$region" "$entry" cagws carrier-gateway carrier-gateway-id
  if [[ -n $sg ]]; then
    if aws_ ec2 delete-security-group --region "$region" --group-id "$sg" >/dev/null; then
      log "deleted security group $sg in $region"
    else
      log "hop: could not delete security group $sg in $region; run 'hop down $region' again"
    fi
  fi
}

abandon() {
  local region=$1 host=$2
  destroy_region "$region" "$(scan_region "$region" | jq -c --arg host "$host" '
    if any(.instances[]; .host != $host)
    then {region, sg: null, subnets: [], rtbs: [], cagws: [], instances: [.instances[] | select(.host == $host)]}
    else . end')"
}

cmd_up() {
  local place='' ttl=$TTL_HOURS spot=0
  while (($#)); do
    case $1 in
      --ttl)
        ttl=${2:-}
        shift 2 || die "--ttl needs a number of hours"
        ;;
      --spot)
        spot=1
        shift
        ;;
      -*) die "unknown option $1" ;;
      *)
        place=$1
        shift
        ;;
    esac
  done
  [[ -n $place ]] || die "usage: hop up <region or zone> [--ttl HOURS] [--spot]"
  [[ $ttl =~ ^[1-9][0-9]*$ ]] || die "--ttl must be a whole number of hours"
  local region zone='' regions existing host id ip
  region=$(region_of "$place")
  if is_zone "$place"; then zone=$place; fi
  regions=$(enabled_regions)
  grep -qx "$region" <<<"$regions" || die "$region is not enabled on this account; see 'hop regions'"
  tailscale status >/dev/null 2>&1 || die "Tailscale is not running on this Mac"
  ts_login

  existing=$(scan_region "$region" | jq -c --arg zone "$zone" \
    '[.instances[] | select(if $zone == "" then (.zone | test("^[a-z]+(-[a-z]+)+-[0-9]+[a-z]$")) else .zone == $zone end)][0] // empty')
  if [[ -n $existing ]]; then
    host=$(jq -r .host <<<"$existing")
    id=$(jq -r .id <<<"$existing")
    log "reusing $host ($id) in $place"
  else
    host="hop-$place-$(openssl rand -hex 2)"
    id=$(launch "$region" "$ttl" "$host" "$zone" "$spot") || {
      abandon "$region" "$host"
      exit 1
    }
  fi

  if ! wait_for_join "$region" "$host" "$id"; then
    [[ -n $existing ]] || abandon "$region" "$host"
    exit 1
  fi

  ip=$(aws_ ec2 describe-instances --region "$region" --instance-ids "$id" \
    --query 'Reservations[0].Instances[0].PublicIpAddress||Reservations[0].Instances[0].NetworkInterfaces[0].Association.CarrierIp' \
    --output text)
  tailscale set --exit-node="$(jq -r '.TailscaleIPs[0]' <<<"$(ts_peer "$host")")"
  verify_egress "$ip" || die "routing through $host is set but the public IP check failed"
  echo "$host $place $ip"
}

cmd_down() {
  local regions entry region
  ts_login || log "hop: no Tailscale API access; Tailscale removes the devices itself once they are offline"
  if (($#)); then
    regions=$(region_of "$1")
    ts_release "hop-$regions-*"
  else
    ts_release 'hop-*'
    regions=$(enabled_regions)
  fi
  scan $regions | jq -c '.[] | select(.sg != null or (.subnets + .rtbs + .cagws + .instances | length > 0))' |
    while read -r entry; do
      region=$(jq -r .region <<<"$entry")
      destroy_region "$region" "$entry"
    done
  if ((!$#)); then
    ts_delete_devices
  fi
}

cmd_status() {
  local current nodes
  current=$(ts_current_exit)
  nodes=$(scan $(enabled_regions) | jq --arg current "$current" \
    '[.[] | .region as $r | .instances[] | . + {region: $r, in_use: (.host == $current)}]')
  if [[ ${1:-} == --json ]]; then
    echo "$nodes"
  elif [[ $(jq length <<<"$nodes") -eq 0 ]]; then
    echo "no nodes running"
  else
    jq -r '["PLACE", "HOST", "IP", "TYPE", "LAUNCHED", "IN USE"],
      (.[] | [.zone, .host, .ip // "-", .type + (if .spot then " spot" else "" end), .launched, (if .in_use then "yes" else "" end)])
      | @tsv' <<<"$nodes" | column -t -s $'\t'
  fi
}

cmd_regions() {
  enabled_regions
}

cmd_zones() {
  local region
  for region in $(enabled_regions); do
    aws_ ec2 describe-availability-zones --region "$region" --all-availability-zones \
      --filters Name=zone-type,Values=local-zone,wavelength-zone \
      --query 'AvailabilityZones[].[ZoneName,ZoneType,OptInStatus]' --output text &
  done | sort
}

cmd_doctor() {
  local failed=0 tool key_id
  check() {
    if ("${@:2}") >/dev/null 2>&1; then
      echo "ok    $1"
    else
      echo "FAIL  $1"
      failed=1
    fi
  }
  for tool in aws tailscale curl jq openssl; do
    check "$tool is installed" command -v "$tool"
  done
  check "HOP_AWS_PROFILE is set in $CONFIG" test -n "${HOP_AWS_PROFILE:-}"
  check "AWS credentials work" aws_ sts get-caller-identity
  check "AWS identity can describe EC2 regions" enabled_regions
  check "Tailscale is running on this Mac" eval '[[ $(tailscale status --json 2>/dev/null | jq -r .BackendState) == Running ]]'
  TS_TOKEN=$(ts_fetch_token 2>/dev/null) || true
  check "Tailscale OAuth client is accepted" test -n "$TS_TOKEN"
  key_id=$(ts_mint_key 2>/dev/null | jq -r '.id // empty') || true
  check "OAuth client can mint keys for $TS_TAG" test -n "$key_id"
  [[ -z $key_id ]] || ts_api DELETE "/tailnet/-/keys/$key_id" >/dev/null 2>&1 || true
  check "OAuth client can list devices" ts_api GET "/tailnet/-/devices?tags=$TS_TAG"
  echo "note  autoApprovers for $TS_TAG can't be read with these scopes; 'hop up' reports it if missing"
  return $failed
}

main() {
  local cmd=${1:-}
  shift || true
  case $cmd in
    up | down | status | regions | zones | doctor) "cmd_$cmd" "$@" ;;
    "" | help | -h | --help) usage ;;
    *) die "unknown command '$cmd'; run 'hop help'" ;;
  esac
}

main "$@"
